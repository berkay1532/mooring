{
  "name": "@mooring/seller",
  "private": true,
  "description": "Mooring's hosted example seller (api.mooring.live): one paid resource over x402 and one over MPP charge, both payable from a Mooring card.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1",
    "@mooring-live/x402-client": "0.4.0",
    "@stellar/stellar-sdk": "17.4.0",
    "@x402/core": "2.32.0",
    "@x402/hono": "2.32.0",
    "@x402/stellar": "2.32.0",
    "hono": "^4.13",
    "mppx": "0.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
