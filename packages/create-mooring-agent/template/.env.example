# The card this agent pays from (C...), created at https://app.mooring.live.
MOORING_CARD=
# The agent key registered as the card's signer (S...). Keep it out of version control.
AGENT_SECRET=
# The paid URL the agent requests (x402 or MPP charge).
MOORING_SERVICE=__SERVICE__
MOORING_NETWORK=__NETWORK__

# Local caps, in USDC, checked before the agent key signs anything (also read from
# mooring.guard.json; see the README). The kit ships with a 1 USDC daily cap; change it freely.
MOORING_DAILY_CAP=1
# MOORING_TOTAL_CAP=1
# MOORING_MAX_PER_TX=0.01

# Optional: where the guard state and the receipt ledger live (default ~/.mooring,
# shared with the mooring CLI) and a Soroban RPC other than the network's default.
# MOORING_HOME=.mooring
# MOORING_RPC_URL=
